{
	"schemaVersion": 1,
	"id": "ethercore",
	"version": "${version}",
	"name": "EtherCore",
	"description": "A cultivation based magic system engine with high customizability and lore.",
	"authors": [
		"Zainyest"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/Zainyest/EtherCore"
	},
	"license": "MIT License",
	"icon": "assets/ethercore/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "zainyest.ethercore.EtherCore"
		],
		"client": [
			"zainyest.ethercore.EtherCoreClient"
		]
	},
	"mixins": [
		"ethercore.mixins.json",
		{
			"config": "ethercore.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
        "fabricloader": ">=0.17.2",
        "minecraft": "~1.21.10",
        "java": ">=21",
        "fabric-api": "*",
		"fabric-key-binding-api-v1": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}